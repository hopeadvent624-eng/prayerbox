# Backend
PORT=4000
NODE_ENV=development
DB_FILE=server/data.sqlite
DATA_FILE=server/data.json
SESSION_SECRET=replace-with-a-long-random-secret
AUTH_ACCESS_TOKEN_TTL_SECONDS=1800
AUTH_REFRESH_TOKEN_TTL_SECONDS=1209600
ALLOWED_ORIGINS=http://localhost:5173
ADMIN_EMAILS=prayerbox@gmail.com
FIXED_ADMIN_ENABLED=true
FIXED_ADMIN_EMAIL=prayerbox@gmail.com
FIXED_ADMIN_PASSWORD=admin123
AUTH_RATE_WINDOW_MS=900000
AUTH_RATE_MAX_ATTEMPTS=20
BACKUP_DIR=server/backups
BACKUP_RETENTION_COUNT=14
BACKUP_INTERVAL_MINUTES=60

# Optional PostgreSQL backend. If DATABASE_URL is empty, SQLite is used.
# DATABASE_URL=postgresql://user:password@host:5432/prayerbox

# One-time restore target (used by npm run db:restore)
# BACKUP_FILE=server/backups/ay-prayerbox-2026-07-13T12-00-00-000Z.sqlite

# Frontend
VITE_API_BASE_URL=http://localhost:4000
